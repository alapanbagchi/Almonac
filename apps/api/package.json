{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:all": "bun test",
    "typecheck": "tsc --noEmit",
    "db:migrate": "bun --env-file=.env ./node_modules/.bin/node-pg-migrate up",
    "db:migrate:down": "bun --env-file=.env ./node_modules/.bin/node-pg-migrate down"
  },
  "dependencies": {
    "@elysia/openapi": "2.0.0-rc.0",
    "elysia": "2.0.0-rc.1",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/pg": "^8.23.1",
    "typescript": "^5.7.0"
  }
}
