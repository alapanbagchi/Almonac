# Copy to .env for local development. Never commit .env.
#
# The control database is separate from the Zitadel database. Use the
# infrastructure/local stack or another PostgreSQL 17 instance.

NODE_ENV=development
PORT=3001

# Required. PostgreSQL URL for the control database.
DATABASE_URL=

# Required for the integration tests. Use a separate database; the tests
# migrate down and delete their own rows.
TEST_DATABASE_URL=

# Zitadel OpenID Connect client. Production URLs must use https.
ZITADEL_ISSUER=
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=
ZITADEL_REDIRECT_URI=
ZITADEL_POST_LOGOUT_URI=

# 32 random bytes, encoded as unpadded base64url (43 characters). Keep the
# value in the secret manager; never commit it. The version identifies the key
# that sealed existing login attempts and ID token hints.
SEALING_KEY=
SEALING_KEY_VERSION=1

# Zitadel management API machine user. The key stays in the secret manager.
# Production requires an https issuer.
ZITADEL_SERVICE_USER_ID=
ZITADEL_SERVICE_USER_KEY_ID=
ZITADEL_SERVICE_USER_PRIVATE_KEY=

# Transactional email (verification and invitation links). SMTP_URL must not
# contain credentials. Use smtps://host:465, or smtp://host:587 with STARTTLS.
# Production requires SMTP_USER and SMTP_PASSWORD, refuses a loopback host and
# requires an https WEB_PUBLIC_ORIGIN.
SMTP_URL=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Almonac
WEB_PUBLIC_ORIGIN=
