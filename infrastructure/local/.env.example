# Local development only. Copy to .env and never commit .env.
#
# This file lists settings and non-secret local values. Secret values are blank.
# Set every blank value before the first start. The stack binds to 127.0.0.1.

# Public origin of the Zitadel API and login UI, as the browser sees it.
ZITADEL_DOMAIN=localhost
ZITADEL_EXTERNALPORT=8080
ZITADEL_PUBLIC_SCHEME=http
ZITADEL_EXTERNALSECURE=false
PROXY_PORT=8080

# Pinned images. Bump both Zitadel images together.
ZITADEL_VERSION=v4.20.1
TRAEFIK_IMAGE=traefik:v3.7.7
POSTGRES_IMAGE=postgres:17.10-alpine

# Email is sent through a real relay. The API and Zitadel each need their own
# SMTP settings in apps/api/.env and in the Zitadel configuration; this stack
# does not run a mail catcher.

# Exactly 32 bytes. Required. Generate with: openssl rand -hex 16
ZITADEL_MASTERKEY=

# At least 32 characters. Required. Signs the login UI session cookie.
# Generate with: openssl rand -hex 32
LOGIN_SESSION_COOKIE_SECRET=

# First-instance administrator password. Required.
# Use a password manager. The password must meet the Zitadel default policy.
ZITADEL_ADMIN_PASSWORD=

# Machine credential written by setup into the bootstrap volume.
LOGIN_CLIENT_PAT_EXPIRATION=2099-01-01T00:00:00Z

# Zitadel database. Local only; no TLS inside the Compose network.
POSTGRES_DB=zitadel
POSTGRES_USER=postgres

# Required. Use letters and digits only. Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=

# Control database. Separate from the Zitadel database.
CONTROL_POSTGRES_DB=almonac_control
CONTROL_POSTGRES_TEST_DB=almonac_control_test
CONTROL_POSTGRES_USER=almonac
CONTROL_POSTGRES_PORT=5433

# Required. Use letters and digits only. Generate with: openssl rand -hex 16
CONTROL_POSTGRES_PASSWORD=
